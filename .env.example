# Copy to .env on the VPS and fill in the secrets. Never commit .env.
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=fc-replace-me
FIRECRAWL_REQUEST_TIMEOUT_SECONDS=30
FIRECRAWL_POLL_INTERVAL_SECONDS=5
FIRECRAWL_POLL_TIMEOUT_SECONDS=75
URL_RESOLUTION_TIMEOUT_SECONDS=20
DOWNLOAD_DIR=/tmp/downloads
ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=30
DEFAULT_CRAWL_LIMIT=1
MAX_CRAWL_LIMIT=1000

ONEDRIVE_ENABLED=true
ONEDRIVE_CLIENT_ID=replace-with-personal-app-client-id
ONEDRIVE_REFRESH_TOKEN=replace-with-delegated-refresh-token
ONEDRIVE_FOLDER=Scraper Function
ONEDRIVE_REQUEST_TIMEOUT_SECONDS=30
