# Copy to .env and fill in the secrets. Never commit .env.

# --- API authentication ---------------------------------------------------
# Comma-separated keys. Send one in the x-api-key header (x-functions-key and
# ?code= are also accepted for callers written for Azure Functions).
API_KEYS=replace-with-a-long-random-key
# Only for local development: accept requests without a key.
API_AUTH_DISABLED=false

# --- Firecrawl --------------------------------------------------------------
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=fc-replace-me
FIRECRAWL_REQUEST_TIMEOUT_SECONDS=30
FIRECRAWL_POLL_INTERVAL_SECONDS=5
# Keep below the caller's HTTP timeout (Power Automate: 120 s).
FIRECRAWL_POLL_TIMEOUT_SECONDS=75
URL_RESOLUTION_TIMEOUT_SECONDS=20
DEFAULT_CRAWL_LIMIT=1
MAX_CRAWL_LIMIT=1000

# --- Local storage ----------------------------------------------------------
# The Docker image defaults to /data/downloads (the persistent volume).
# For a local uvicorn run, use a relative path such as: downloads
# DOWNLOAD_DIR=/data/downloads
ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=30

# --- Optional OneDrive upload (personal Microsoft account) -----------------
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=replace-with-personal-app-client-id
ONEDRIVE_REFRESH_TOKEN=replace-with-delegated-refresh-token
ONEDRIVE_FOLDER=Scraper Function
ONEDRIVE_REQUEST_TIMEOUT_SECONDS=30

# --- Service ----------------------------------------------------------------
LOG_LEVEL=INFO
# Host address/port published by docker compose. 127.0.0.1 keeps the service
# reachable only through a reverse proxy on the same host; use 0.0.0.0 to
# expose it directly (then requests bypass TLS and can spoof X-Forwarded-*).
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
