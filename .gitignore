# -----------------------------------------------------------------------------
# Secrets and local configuration — never commit real credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.direnv/
local.settings.json

# Credential exports, service-account files and private keys
credentials*.json
service-account*.json
client_secret*.json
secrets*.json
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.netrc
.pypirc

# Cloud/provider credentials accidentally copied into the repository
.aws/
.azure/
.config/gcloud/

# -----------------------------------------------------------------------------
# Python environments, caches, coverage and build outputs
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
